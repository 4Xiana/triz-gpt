# 复制本文件为 .env 并填入你的 API Key；不配置则系统使用内置演示模型运行
# MiniMax 开放平台（OpenAI 兼容接口）
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=
LLM_MODEL=MiniMax-Text-01
# 在线嵌入模型名（MiniMax 填 embo-01；留空则使用本地哈希向量，不影响主流程）
LLM_EMBEDDING_MODEL=embo-01
# MiniMax-M3 思考模式：默认 0 开启（思考流实时展示、完毕折叠）；设 1 关闭思考以提速
LLM_DISABLE_THINKING=0

# 说明：其他 OpenAI 兼容服务（DeepSeek/智谱/本地vLLM 等）同样只需修改上面配置项；
# 非 MiniMax 供应商的 /embeddings 若为 OpenAI 协议（input/data），嵌入调用会解析失败
# 并自动兜底本地向量，对话功能不受影响。
